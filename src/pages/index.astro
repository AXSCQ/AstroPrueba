---
import Layout from "../layouts/Layout.astro";
import DawPanel from "../components/DawPanel.astro";
import { Image } from 'astro:assets';
import perfilImage from "../assets/images/perfil.jpg";
import bajistaImage from "../assets/images/bajista.jpg";
import Contact from "../components/Contact.astro";
import ProfileModal from "../components/ProfileModal.astro";
// Audio visualizer optimizado con lazy loading inteligente
import MultiTrackAudioVisualizer from "../components/MultiTrackAudioVisualizer.astro";
// Nuevos componentes de proyectos
import ProjectsGalleryModal from "../components/ProjectsGalleryModal.astro";
import ProjectDetailModal from "../components/ProjectDetailModal.astro";
import projectsData from "../data/projects.json";

const { projects } = projectsData;
---

<Layout title="Axel Simon Condori - Portfolio">
  <div class="min-h-screen bg-studio-chassis-950 p-2 sm:p-4 md:p-8 overflow-x-hidden">
    <!-- Marco de consola central -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 max-w-7xl mx-auto px-1 sm:px-2 md:px-4">
      
      <!-- Profile Panel / Master Preamp -->
      <DawPanel title="MASTER PREAMP // PROFILE" variant="default" channel="CH 01" class="lg:col-span-2" data-track="vocals">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 w-full">
          <div class="relative group">
            <div class="w-20 h-20 xs:w-24 xs:h-24 sm:w-32 sm:h-32 rounded-xl overflow-hidden border border-studio-chassis-600 bg-studio-chassis-900 shadow-bezel-out relative">
              <Image
                src={perfilImage}
                alt="Axel Simon Condori"
                class="w-full h-full object-cover grayscale-[20%] contrast-[1.05] group-hover:grayscale-0 transition-all duration-300"
                width={128}
                height={128}
                loading="eager"
                decoding="async"
                format="webp"
                quality={85}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-studio-chassis-950/60 to-transparent pointer-events-none"></div>
            </div>
            <!-- Indicador de canal activo -->
            <div class="absolute -bottom-1 -right-1 bg-studio-chassis-900 border border-studio-chassis-600 rounded px-1.5 py-0.5 flex items-center gap-1 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-studio-green animate-pulse"></span>
              <span class="text-[8px] font-mono text-studio-cream/80 uppercase font-bold">ONLINE</span>
            </div>
          </div>

          <div class="text-center sm:text-left flex-1">
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1">
              <span class="silk-label text-[9px] bg-studio-chassis-900/90 text-studio-slate border border-studio-slate/30 px-2 py-0.5 rounded">FULL STACK DEVELOPER</span>
              <span class="silk-label text-[9px] bg-studio-chassis-900/90 text-studio-amber border border-studio-amber/30 px-2 py-0.5 rounded">BASSIST // MUSICIAN</span>
            </div>

            <h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-studio-cream mb-1 tracking-tight">
              Axel Simon <span class="text-studio-slate">Condori Quispe</span>
            </h1>
            <p class="text-studio-cream/60 text-xs sm:text-sm font-mono mb-3">
              Ingeniería de software combinada con ritmo, arquitectura y precisión analógica.
            </p>
            
            <!-- Botón táctil para abrir el modal de perfil -->
            <button 
              id="profileModalBtn" 
              class="btn btn-studio-slate text-xs xs:text-sm px-4 py-2 mx-auto sm:mx-0 shadow-bezel-out"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>Inspeccionar Biografía & Skills</span>
            </button>
          </div>
        </div>
      </DawPanel>
    

      <!-- Music Projects / Analog Tone Section -->
      <DawPanel title="TONE & GROOVE // BASS" variant="music" channel="CH 02" data-track="other">
        <div class="relative space-y-3">
          <div class="relative rounded-lg overflow-hidden border border-studio-chassis-700 bg-studio-chassis-950 aspect-video sm:aspect-auto sm:h-36">
            <Image
              src={bajistaImage}
              alt="Music Projects - Bajista"
              class="w-full h-full object-cover opacity-85 hover:opacity-100 transition-opacity duration-300"
              width={300}
              height={200}
              loading="lazy"
              decoding="async"
              format="webp"
              quality={80}
            />
            <div class="absolute bottom-2 left-2 right-2 flex justify-between items-center bg-studio-chassis-950/85 backdrop-blur-sm px-2 py-1 rounded border border-studio-chassis-700/60">
              <span class="text-[9px] font-mono text-studio-amber font-semibold">AMPEG SVT // TONE</span>
              <span class="text-[9px] font-mono text-studio-cream/60">4-STRING DRIVE</span>
            </div>
          </div>

          <!-- Controles de Tono / EQ Band Sliders -->
          <div class="space-y-2 pt-1">
            {
              [
                { label: 'Low End (Bajo)', value: '88%', db: '+6 dB' },
                { label: 'Dynamic Range (Creatividad)', value: '92%', db: '+8 dB' },
                { label: 'Gain Boost (Pasión)', value: '95%', db: '+10 dB' },
              ].map((item, index) => (
                <div class="space-y-1" data-key={index}>
                  <div class="flex justify-between text-[10px] font-mono">
                    <span class="text-studio-cream/70">{item.label}</span>
                    <span class="text-studio-amber font-semibold">{item.db}</span>
                  </div>
                  <div class="h-1.5 bg-studio-chassis-950 rounded-full overflow-hidden border border-studio-chassis-700 p-[1px]">
                    <div class="h-full bg-gradient-to-r from-studio-amber-dim to-studio-amber rounded-full" style={`width: ${item.value}`}></div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </DawPanel>

      <!-- Code Editor Panel / Logic Engine -->
      <DawPanel title="DEVELOPER LOGIC // SYNTH" variant="code" channel="CH 03" class="lg:col-span-2" data-track="other">
        <div class="font-mono text-xs overflow-x-auto max-w-full bg-studio-chassis-950/90 rounded-lg p-3 border border-studio-chassis-700/80 shadow-bezel-in">
          <div class="flex items-center justify-between border-b border-studio-chassis-800 pb-2 mb-2 select-none">
            <span class="silk-label text-[9px] text-studio-slate">MODULE: developer.ts</span>
            <span class="text-[9px] font-mono text-studio-cream/40">STATUS: COMPILED & READY</span>
          </div>
          <pre class="text-studio-cream/85 overflow-x-auto text-[10px] xs:text-xs leading-relaxed font-mono">
<code><span class="text-studio-slate">class</span> <span class="text-studio-amber">Developer</span> &#123;
  <span class="text-studio-cream/60">name</span> = <span class="text-studio-green">"Axel Simon Condori Quispe"</span>;
  <span class="text-studio-cream/60">experience</span> = <span class="text-studio-amber">"2+ años profesionales"</span>;
  <span class="text-studio-cream/60">focus</span> = <span class="text-studio-slate">"Full Stack & Soluciones Web Escalables"</span>;
  
  <span class="text-studio-cream/60">stack</span> = &#123;
    <span class="text-studio-slate">frontend</span>: [<span class="text-studio-green">"React"</span>, <span class="text-studio-green">"Astro"</span>, <span class="text-studio-green">"TypeScript"</span>, <span class="text-studio-green">"Tailwind"</span>],
    <span class="text-studio-slate">backend</span>:  [<span class="text-studio-green">"Node.js"</span>, <span class="text-studio-green">"PHP/Laravel"</span>, <span class="text-studio-green">"Python"</span>],
    <span class="text-studio-slate">database</span>: [<span class="text-studio-green">"PostgreSQL"</span>, <span class="text-studio-green">"MySQL"</span>, <span class="text-studio-green">"Redis"</span>],
    <span class="text-studio-slate">devops</span>:   [<span class="text-studio-green">"Docker"</span>, <span class="text-studio-green">"Linux"</span>, <span class="text-studio-green">"Git"</span>, <span class="text-studio-green">"CI/CD"</span>]
  &#125;;

  <span class="text-studio-amber">buildProject</span>(idea) &#123;
    <span class="text-studio-slate">return</span> <span class="text-studio-green">`High performance app with solid audio/code architecture`</span>;
  &#125;
&#125;</code>
          </pre>
        </div>
      </DawPanel>

      <!-- Projects Grid / Master Tape Deck -->
      <DawPanel title="PROJECT MASTERS // RACK" variant="default" channel="CH 04" data-track="drums">
        <div class="space-y-3.5">
          <!-- Preview de proyectos en formato módulo de cinta -->
          <div class="grid grid-cols-2 gap-2">
            {projects.slice(0, 2).map((project) => (
              <div class="group relative aspect-video rounded-lg overflow-hidden border border-studio-chassis-700 bg-studio-chassis-950 shadow-bezel-in">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover opacity-60 group-hover:opacity-85 transition-opacity duration-300"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-studio-chassis-950 via-studio-chassis-950/40 to-transparent flex flex-col justify-end p-1.5 sm:p-2">
                  <span class="text-[8px] font-mono uppercase text-studio-amber font-semibold">TAPE 0{projects.indexOf(project) + 1}</span>
                  <span class="text-[11px] font-mono text-studio-cream font-medium truncate">{project.title}</span>
                </div>
              </div>
            ))}
          </div>
          
          <!-- Indicadores de estado numéricos estilo display -->
          <div class="grid grid-cols-2 gap-2 bg-studio-chassis-950/80 p-2 rounded-lg border border-studio-chassis-700/80">
            <div class="text-center border-r border-studio-chassis-800 pr-1">
              <p class="text-base sm:text-lg font-mono font-bold text-studio-slate">{projects.filter(p => p.category === 'professional').length}</p>
              <p class="text-[9px] font-mono uppercase tracking-wider text-studio-cream/50">PRO MASTERS</p>
            </div>
            <div class="text-center pl-1">
              <p class="text-base sm:text-lg font-mono font-bold text-studio-amber">{projects.length}</p>
              <p class="text-[9px] font-mono uppercase tracking-wider text-studio-cream/50">TOTAL STEMS</p>
            </div>
          </div>
          
          <!-- Botón para abrir galería -->
          <button
            id="openProjectsGalleryBtn"
            class="btn btn-studio-amber w-full py-2.5 text-xs sm:text-sm font-medium shadow-bezel-out"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>Explorar Galería de Proyectos</span>
          </button>
        </div>
      </DawPanel>

      <!-- Contact Panel / Master I/O Strip -->
      <DawPanel title="MASTER OUTPUT // I/O" variant="contact" channel="MASTER" class="col-span-1 md:col-span-2 lg:col-span-3" data-track="bass">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-1">
          <div class="text-center sm:text-left">
            <span class="silk-label text-[9px] text-studio-red">LINE LEVEL OUTPUT</span>
            <p class="text-xs sm:text-sm font-mono text-studio-cream/80">¿Listo para conectar y empezar una colaboración o proyecto?</p>
          </div>
          <button 
            id="contactModalBtn"
            class="btn btn-studio-red text-xs sm:text-sm px-6 py-2.5 whitespace-nowrap shadow-bezel-out"
          >
            <span class="w-2 h-2 rounded-full bg-studio-red animate-pulse mr-1"></span>
            <span>Abrir Terminal de Contacto</span>
          </button>
        </div>
      </DawPanel>
    </div>
  </div>
    </div>
  </div>
  
  <!-- Añade el modal de perfil -->
  <ProfileModal 
    id="profile-modal" 
    name="Axel Simon Condori Quispe" 
    title="Desarrollador Full Stack & Músico"
    photoSrc={perfilImage}
    cvPath="/files/cv-axel-condori.pdf"
  />
  
  <!-- Modal de contacto completo que se mostrará al hacer clic en el botón -->
  <dialog id="contactModal" class="fixed inset-0 bg-cyber-950/80 backdrop-blur-md z-50 w-full h-full p-0 m-0 overflow-y-auto">
    <div class="container mx-auto h-full overflow-auto py-6 sm:py-8 md:py-10 px-2 sm:px-4">
      <div class="flex justify-end mb-4 px-4">
        <button id="closeContactBtn" class="text-white hover:text-neon-blue p-1 sm:p-2 rounded-full bg-cyber-800/70 shadow-lg shadow-white/10 hover:shadow-white/30 min-w-11 min-h-11 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-8 sm:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5));">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <Contact />
    </div>
  </dialog>

  <script>
    // Configurar todos los modales
    document.addEventListener('DOMContentLoaded', () => {
      // Modal de contacto
      const contactModalBtn = document.getElementById('contactModalBtn');
      const contactModal = document.getElementById('contactModal');
      const closeContactBtn = document.getElementById('closeContactBtn');
      
      if (contactModalBtn && contactModal instanceof HTMLDialogElement && closeContactBtn) {
        contactModalBtn.addEventListener('click', () => {
          contactModal.showModal();
          document.body.classList.add('overflow-hidden');
        });
        
        closeContactBtn.addEventListener('click', () => {
          contactModal.close();
          document.body.classList.remove('overflow-hidden');
        });
        
        // Cerrar al hacer clic fuera del contenido
        contactModal.addEventListener('click', (e) => {
          const dialogDimensions = contactModal.getBoundingClientRect();
          if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
          ) {
            contactModal.close();
            document.body.classList.remove('overflow-hidden');
          }
        });
      }
      
      // Modal de perfil
      const profileModalBtn = document.getElementById('profileModalBtn');
      const profileModal = document.getElementById('profile-modal');
      
      if (profileModalBtn && profileModal instanceof HTMLDialogElement) {
        profileModalBtn.addEventListener('click', () => {
          profileModal.showModal();
          document.body.classList.add('overflow-hidden');
        });
      }
      
      // Modal de galería de proyectos
      const openGalleryBtn = document.getElementById('openProjectsGalleryBtn');
      const galleryModal = document.getElementById('projects-gallery-modal');
      
      if (openGalleryBtn && galleryModal instanceof HTMLDialogElement) {
        openGalleryBtn.addEventListener('click', () => {
          galleryModal.showModal();
          document.body.classList.add('overflow-hidden');
        });
      }
    });
  </script>
  
  <!-- Modal de galería de proyectos -->
  <ProjectsGalleryModal projects={projects} />
  
  <!-- Modales de detalle para cada proyecto -->
  {projects.map((project, index) => (
    <ProjectDetailModal project={project} index={index} />
  ))}
  
  <!-- Visualizador de audio multitrack con carga diferida -->
  <div id="visualizer-container" class="hidden">
    <MultiTrackAudioVisualizer />
  </div>
  
  <script>
    // Carga diferida del visualizador de audio
    document.addEventListener('DOMContentLoaded', () => {
      // Esperar a que la página esté completamente cargada
      setTimeout(() => {
        const container = document.getElementById('visualizer-container');
        if (container) {
          container.classList.remove('hidden');
          // Disparar un evento personalizado para notificar que el visualizador está listo
          document.dispatchEvent(new CustomEvent('visualizer-loaded'));
        }
      }, 1000); // Retrasar 1 segundo para priorizar la carga inicial de la página
    });
  </script>
</Layout>
