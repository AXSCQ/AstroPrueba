---
import "../assets/styles/tailwind.css";
import perfilImage from "../assets/images/perfil.jpg";

interface Props {
  title: string;
  description?: string;
}

const SITE_URL = "https://axscq.netlify.app/";

const {
  title,
  description = "Axel Simon Condori Quispe — Desarrollador Full Stack & Músico. Portafolio interactivo con consola de mezcla de audio.",
} = Astro.props;

const ogImageUrl = new URL(perfilImage.src, SITE_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preload crítico para mejorar performance -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">

    <!-- DNS prefetch para dominios externos -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <!-- CSS crítico en noscript para fallback -->
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap">
    </noscript>
  </head>
  <body class="bg-studio-chassis-950 text-studio-cream font-light antialiased selection:bg-studio-amber selection:text-studio-chassis-950">
    <!-- Textura sutil de metal anodizado/cepillado de rack -->
    <div class="fixed inset-0 bg-gradient-to-b from-white/[0.015] via-transparent to-black/40 pointer-events-none"></div>
    <div class="relative z-10">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
