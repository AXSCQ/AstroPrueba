---
interface Project {
  id: string;
  title: string;
  shortDescription: string;
  description: string;
  image: string;
  technologies: string[];
  features: string[];
  category: string;
  client: string | null;
  event: string | null;
  role?: string | null;
  links: {
    demo: string | null;
    github: string | null;
    facebook?: string | null;
  };
}

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<dialog id={`project-detail-${index}`} class="modal bg-transparent">
  <div
    class="fixed inset-0 bg-studio-chassis-950/90 backdrop-blur-md z-50 flex items-center justify-center p-2 sm:p-4"
  >
    <div
      class="rack-chassis w-full max-w-2xl relative overflow-hidden max-h-[95vh] md:max-h-[90vh] overflow-y-auto"
    >
      <!-- Tornillería de rack en las 4 esquinas -->
      <div class="absolute top-2.5 left-2.5 rack-screw"></div>
      <div class="absolute top-2.5 right-2.5 rack-screw"></div>
      <div class="absolute bottom-2.5 left-2.5 rack-screw"></div>
      <div class="absolute bottom-2.5 right-2.5 rack-screw"></div>

      <!-- Header del Inspector -->
      <div class="sticky top-0 z-20 bg-studio-chassis-950/95 backdrop-blur-sm border-b border-studio-chassis-700/80 p-3.5 sm:p-4 flex items-center justify-between pl-6 pr-6 select-none">
        <button
          class="back-to-gallery-btn btn btn-studio-slate text-xs py-1.5 px-3 shadow-bezel-out"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Volver al Rack de Proyectos</span>
        </button>

        <button
          class="close-detail-btn p-1.5 rounded-lg bg-studio-chassis-800 border border-studio-chassis-600 text-studio-cream/70 hover:text-white hover:bg-studio-chassis-700 transition-all shadow-bezel-out active:shadow-bezel-in"
          aria-label="Cerrar detalle"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Placa de Identificación del Proyecto -->
      <div class="px-4 sm:px-6 pt-4 pb-3 bg-studio-chassis-900 border-b border-studio-chassis-800">
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class="silk-label text-[9px] bg-studio-chassis-950 text-studio-amber border border-studio-amber/30 px-2 py-0.5 rounded">ITEM 0{index + 1}</span>
          <span class="silk-label text-[9px] bg-studio-chassis-950 text-studio-slate border border-studio-slate/30 px-2 py-0.5 rounded">INSPECTION MODULE</span>
        </div>

        <h3 class="font-mono text-xl sm:text-2xl font-bold text-studio-cream tracking-tight">
          {project.title}
        </h3>

        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1 text-xs font-mono text-studio-cream/60">
          {project.event && (
            <span class="text-studio-amber font-semibold">📍 Evento: {project.event}</span>
          )}
          {project.client && (
            <span>🏢 Cliente: {project.client}</span>
          )}
        </div>
      </div>

      <!-- Imagen del Proyecto / Módulo de Display -->
      <div class="p-4 sm:p-6 bg-studio-chassis-950/60">
        <div class="rounded-lg overflow-hidden border border-studio-chassis-700 shadow-bezel-in">
          <img
            src={project.image}
            alt={project.title}
            class="w-full h-48 sm:h-64 object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Contenido Detallado -->
      <div class="p-4 sm:p-6 space-y-5">
        <!-- Descripción -->
        <div class="rack-slot p-4">
          <span class="silk-label text-[9px] text-studio-slate block mb-1.5">SYSTEM OVERVIEW</span>
          <p class="text-studio-cream/85 text-xs sm:text-sm leading-relaxed font-sans">
            {project.description}
          </p>
        </div>

        <!-- Mi rol en el proyecto -->
        {project.role && (
          <div class="rack-slot p-4 border-l-2 border-l-studio-amber">
            <h4 class="font-mono text-xs font-bold text-studio-amber mb-1.5 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-studio-amber shadow-led-amber"></span>
              <span>MI ROL EN EL PROYECTO</span>
            </h4>
            <p class="text-studio-cream/80 text-xs sm:text-sm leading-relaxed font-sans">
              {project.role}
            </p>
          </div>
        )}

        <!-- Características Principales -->
        <div class="rack-slot p-4">
          <h4 class="font-mono text-xs font-bold text-studio-slate mb-3 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-studio-slate shadow-led-slate"></span>
            <span>CARACTERÍSTICAS TÉCNICAS CLAVE</span>
          </h4>
          <ul class="space-y-2 font-mono text-xs sm:text-sm text-studio-cream/80">
            {project.features.map((feature) => (
              <li class="flex items-start gap-2">
                <span class="text-studio-slate mt-0.5">►</span>
                <span class="font-sans text-xs sm:text-sm">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Enlaces / Pulsadores de Transporte -->
        {(project.links.github || project.links.demo || project.links.facebook) && (
          <div class="flex flex-wrap gap-3 pt-2">
            {project.links.demo && (
              <a
                href={project.links.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-studio-cream text-xs sm:text-sm px-5 py-2.5 shadow-bezel-out"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span>VER DEMO EN VIVO</span>
              </a>
            )}
            {project.links.github && (
              <a
                href={project.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-studio-slate text-xs sm:text-sm px-5 py-2.5 shadow-bezel-out"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <span>CÓDIGO FUENTE</span>
              </a>
            )}
            {project.links.facebook && (
              <a
                href={project.links.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-studio-slate text-xs sm:text-sm px-4 py-2.5 shadow-bezel-out"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span>PÁGINA OFICIAL</span>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Footer con Microcomponentes / Tecnologías -->
      <div class="border-t border-studio-chassis-700/80 p-4 sm:p-5 bg-studio-chassis-950/90 select-none">
        <span class="silk-label text-[9px] text-studio-cream/50 mb-2 block">HARDWARE & SOFTWARE STACK</span>
        <div class="flex flex-wrap gap-1.5">
          {project.technologies.map((tech) => (
            <span class="px-2.5 py-1 bg-studio-chassis-850 text-studio-slate font-mono text-xs rounded border border-studio-chassis-700 shadow-sm">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</dialog>

<script define:vars={{ index }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById(`project-detail-${index}`);
    const closeBtn = modal?.querySelector('.close-detail-btn');
    const backBtn = modal?.querySelector('.back-to-gallery-btn');
    const galleryModal = document.getElementById('projects-gallery-modal');

    function closeModal() {
      modal?.close();
      document.body.classList.remove('overflow-hidden');
    }

    function backToGallery() {
      modal?.close();
      if (galleryModal instanceof HTMLDialogElement) {
        galleryModal.showModal();
        document.body.classList.add('overflow-hidden');
      }
    }

    closeBtn?.addEventListener('click', closeModal);
    backBtn?.addEventListener('click', backToGallery);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>

<style>
  .modal::backdrop {
    background: transparent;
  }
</style>

