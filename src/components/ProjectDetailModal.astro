---
interface Project {
  id: string;
  title: string;
  shortDescription: string;
  description: string;
  image: string;
  technologies: string[];
  features: string[];
  category: string;
  client: string | null;
  event: string | null;
  role?: string | null;
  links: {
    demo: string | null;
    github: string | null;
    facebook?: string | null;
  };
}

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<dialog id={`project-detail-${index}`} class="modal bg-transparent">
  <div
    class="fixed inset-0 bg-cyber-950/90 backdrop-blur-md z-50 flex items-center justify-center p-2 sm:p-4"
  >
    <div
      class="bg-cyber-800 border border-neon-blue/20 rounded-xl w-full max-w-2xl relative overflow-hidden shadow-2xl shadow-neon-blue/10 max-h-[95vh] md:max-h-[90vh] overflow-y-auto"
    >
      <!-- Efectos de brillo -->
      <div class="absolute -top-10 -left-10 w-20 h-20 bg-neon-blue/20 blur-xl hidden sm:block"></div>
      <div class="absolute -bottom-10 -right-10 w-20 h-20 bg-neon-purple/20 blur-xl hidden sm:block"></div>

      <!-- Header -->
      <div class="sticky top-0 z-20 bg-cyber-950/95 backdrop-blur-sm p-4 flex items-center justify-between">
        <button
          class="back-to-gallery-btn text-white/70 hover:text-neon-blue transition-colors flex items-center gap-2 text-sm"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Volver a proyectos
        </button>
        <button
          class="close-detail-btn text-white/70 hover:text-white transition-colors p-2 rounded-full bg-cyber-800/50 hover:bg-cyber-700"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Título destacado -->
      <div class="px-4 sm:px-6 pb-4 bg-cyber-950/95">
        <div class="bg-neon-blue/90 rounded-lg shadow-[0_0_20px_rgba(0,200,255,0.3)] px-6 py-3 inline-block">
          <h2 class="text-lg sm:text-xl font-bold text-cyber-950">
            {project.title}
          </h2>
        </div>
        {project.event && (
          <p class="text-neon-purple text-sm mt-2">
            📍 Presentado en {project.event}
          </p>
        )}
        {project.client && (
          <p class="text-white/60 text-sm mt-1">
            🏢 Cliente: {project.client}
          </p>
        )}
      </div>

      <!-- Imagen -->
      <div class="px-4 sm:px-6">
        <img
          src={project.image}
          alt={project.title}
          class="w-full h-48 sm:h-64 object-cover rounded-lg shadow-lg"
          loading="lazy"
        />
      </div>

      <!-- Contenido -->
      <div class="p-4 sm:p-6 space-y-6">
        <!-- Descripción -->
        <div>
          <p class="text-white leading-relaxed">
            {project.description}
          </p>
        </div>

        <!-- Mi rol en el proyecto -->
        {project.role && (
          <div class="bg-cyber-700/30 border border-neon-purple/20 rounded-lg p-4">
            <h3 class="text-neon-purple font-semibold mb-2 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Mi rol en el proyecto
            </h3>
            <p class="text-white/80 text-sm leading-relaxed">
              {project.role}
            </p>
          </div>
        )}

        <!-- Características -->
        <div>
          <h3 class="text-neon-blue font-semibold mb-3 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Características principales
          </h3>
          <ul class="space-y-2">
            {project.features.map((feature) => (
              <li class="text-white/80 flex items-start gap-2">
                <span class="text-neon-blue mt-1">•</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Links -->
        {(project.links.github || project.links.demo || project.links.facebook) && (
          <div class="flex flex-wrap gap-3 pt-2">
            {project.links.demo && (
              <a
                href={project.links.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 bg-gradient-to-r from-neon-blue to-neon-purple text-white font-medium rounded-lg hover:from-neon-purple hover:to-neon-blue transition-all duration-300 shadow-lg shadow-neon-blue/30 flex items-center gap-2 transform hover:scale-105"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Ver Demo
              </a>
            )}
            {project.links.github && (
              <a
                href={project.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 bg-cyber-700 border border-white/20 text-white font-medium rounded-lg hover:bg-cyber-600 transition-all flex items-center gap-2"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
            )}
            {project.links.facebook && (
              <a
                href={project.links.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 bg-[#1877F2] text-white font-medium rounded-lg hover:bg-[#166FE5] transition-all flex items-center gap-2"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Footer con tecnologías -->
      <div class="border-t border-neon-blue/10 p-4 sm:p-5 bg-cyber-900/50">
        <p class="text-white/50 text-xs mb-2 uppercase tracking-wider">Tecnologías utilizadas</p>
        <div class="flex flex-wrap gap-2">
          {project.technologies.map((tech) => (
            <span class="px-3 py-1.5 bg-cyber-700/50 text-neon-blue text-sm rounded-full border border-neon-blue/20 shadow-sm shadow-neon-blue/10">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</dialog>

<script define:vars={{ index }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById(`project-detail-${index}`);
    const closeBtn = modal?.querySelector('.close-detail-btn');
    const backBtn = modal?.querySelector('.back-to-gallery-btn');
    const galleryModal = document.getElementById('projects-gallery-modal');

    function closeModal() {
      modal?.close();
      document.body.classList.remove('overflow-hidden');
    }

    function backToGallery() {
      modal?.close();
      if (galleryModal instanceof HTMLDialogElement) {
        galleryModal.showModal();
        document.body.classList.add('overflow-hidden');
      }
    }

    closeBtn?.addEventListener('click', closeModal);
    backBtn?.addEventListener('click', backToGallery);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>

<style>
  .modal::backdrop {
    background: transparent;
  }
</style>
