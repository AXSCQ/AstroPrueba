---

<section id="contacto" class="py-6 sm:py-10 relative select-none">
  <div class="rack-chassis p-4 sm:p-7 max-w-5xl mx-auto relative overflow-hidden">
    <!-- Tornillos de rack en las esquinas -->
    <div class="absolute top-3 left-3 rack-screw"></div>
    <div class="absolute top-3 right-3 rack-screw"></div>
    <div class="absolute bottom-3 left-3 rack-screw"></div>
    <div class="absolute bottom-3 right-3 rack-screw"></div>

    <!-- Header del Patch Bay -->
    <div class="flex items-center justify-between border-b border-studio-chassis-700/80 pb-3 mb-6 pl-4 pr-4">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-studio-red shadow-led-red"></span>
        <div>
          <span class="silk-label text-[9px] text-studio-red">MASTER PATCH BAY // I/O TERMINAL</span>
          <h3 class="font-mono text-xl sm:text-2xl font-bold text-studio-cream">
            ¿Iniciamos una pista juntos?
          </h3>
        </div>
      </div>
      <span class="text-[9px] font-mono text-studio-cream/40 hidden sm:inline">IMPEDANCE: LOW Z // READY</span>
    </div>

    <!-- Tarjetas de Conexión / Terminales de Audio -->
    <div class="grid gap-4 md:grid-cols-12 mb-6">
      
      <!-- Terminal Principal: Correo Electrónico -->
      <div class="md:col-span-7 rack-slot p-4 sm:p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3 border-b border-studio-chassis-700/60 pb-2">
            <span class="silk-label text-[9px] text-studio-slate">{contactInfo.email.terminal}</span>
            <span class="silk-label text-[8px] bg-studio-chassis-950 text-studio-green border border-studio-green/30 px-2 py-0.5 rounded">PRIMARY CHANNEL</span>
          </div>

          <div class="flex items-start gap-3 mb-3">
            <div class="p-2 rounded-lg bg-studio-chassis-950 text-studio-slate border border-studio-chassis-700 shadow-bezel-in">
              <Fragment set:html={contactInfo.email.icon} />
            </div>
            <div>
              <h4 class="font-mono text-base font-bold text-studio-cream">{contactInfo.email.title}</h4>
              <p class="font-mono text-xs text-studio-slate">{contactInfo.email.value}</p>
            </div>
          </div>

          <p class="text-studio-cream/70 text-xs leading-relaxed font-sans mb-4">
            {contactInfo.email.description}
          </p>
        </div>

        <a
          href="mailto:axelcondori78@gmail.com?subject=Contacto%20desde%20tu%20portafolio"
          class="btn btn-studio-slate w-full py-2.5 text-xs font-mono shadow-bezel-out"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path>
          </svg>
          <span>ENVIAR CORREO DIRECTO</span>
        </a>
      </div>

      <!-- Terminales Secundarios: WhatsApp y Ubicación -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <!-- WhatsApp Directo -->
        <div class="rack-slot p-4 flex flex-col justify-between flex-1">
          <div>
            <div class="flex items-center justify-between mb-2 border-b border-studio-chassis-700/60 pb-1.5">
              <span class="silk-label text-[9px] text-studio-green">{contactInfo.whatsapp.terminal}</span>
              <span class="w-2 h-2 rounded-full bg-studio-green shadow-led-green"></span>
            </div>
            <div class="flex items-center gap-2 mb-1">
              <div class="p-1.5 rounded bg-studio-chassis-950 text-studio-green border border-studio-chassis-700">
                <Fragment set:html={contactInfo.whatsapp.icon} />
              </div>
              <div>
                <h5 class="font-mono text-xs font-bold text-studio-cream">{contactInfo.whatsapp.title}</h5>
                <span class="font-mono text-xs text-studio-green">{contactInfo.whatsapp.value}</span>
              </div>
            </div>
          </div>

          <a
            href={`https://web.whatsapp.com/send?phone=59177549627&text=Hola%20Axel%2C%20te%20contacto%20desde%20tu%20portafolio%20web.`}
            class="btn btn-studio-amber w-full py-2 mt-2 text-xs font-mono shadow-bezel-out"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>INICIAR CHAT DIRECTO</span>
          </a>
        </div>

        <!-- Ubicación de Estación -->
        <div class="rack-slot p-4">
          <div class="flex items-center justify-between mb-2 border-b border-studio-chassis-700/60 pb-1.5">
            <span class="silk-label text-[9px] text-studio-amber">{contactInfo.ubicacion.terminal}</span>
            <span class="font-mono text-[9px] text-studio-cream/50">NODE: BO-LPZ</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="p-1.5 rounded bg-studio-chassis-950 text-studio-amber border border-studio-chassis-700">
              <Fragment set:html={contactInfo.ubicacion.icon} />
            </div>
            <div>
              <h5 class="font-mono text-xs font-bold text-studio-cream">{contactInfo.ubicacion.title}</h5>
              <span class="font-mono text-xs text-studio-cream/70">{contactInfo.ubicacion.value}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Redes / Bus de Enlaces Externos -->
    <div class="border-t border-studio-chassis-700/80 pt-4 flex flex-wrap items-center justify-between gap-3">
      <span class="silk-label text-[9px] text-studio-cream/40">EXTERNAL BUS & PROFILES</span>
      <div class="flex gap-3">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-studio-slate text-xs py-1.5 px-3 font-mono shadow-bezel-out"
            aria-label={link.name}
          >
            <Fragment set:html={link.icon} />
            <span>{link.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

