---

---

<!-- Audio Player Accordion: módulo de consola de audio atornillado al chasis -->
<div
    id="audio-player-accordion"
    class="fixed bottom-4 left-4 z-50 bg-studio-chassis-900 rounded-xl border border-studio-chassis-700 shadow-rack-panel transition-all duration-300 ease-in-out"
    style="width: auto; max-width: 95vw;"
>
    <!-- Header del Acordeón -->
    <button
        id="accordion-toggle"
        class="w-full p-2.5 sm:p-3.5 flex items-center justify-between text-left hover:bg-white/5 rounded-xl transition-all duration-200 select-none"
        aria-expanded="false"
        aria-controls="accordion-content"
    >
        <div class="flex items-center gap-2.5">
            <div class="w-2 h-2 rounded-full bg-studio-green shadow-led-green"></div>
            <div>
                <div class="flex items-center gap-1.5">
                    <span class="silk-label text-[8px] bg-studio-chassis-950 px-1 py-0.5 rounded border border-studio-chassis-700 text-studio-amber">AUDIO RACK</span>
                    <h3 class="text-xs sm:text-sm font-mono font-bold text-studio-cream">MultiTrack Engine</h3>
                </div>
                <p class="text-[10px] font-mono text-studio-cream/60 hidden sm:block" id="audio-status">
                    Listo para reproducir
                </p>
            </div>
        </div>
        <svg
            id="chevron-icon"
            class="w-4 h-4 sm:w-5 sm:h-5 text-studio-slate transform transition-transform duration-200 ml-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>

    <!-- Contenido Colapsible -->
    <div
        id="accordion-content"
        class="overflow-hidden transition-all duration-300 ease-in-out"
        style="max-height: 0;"
        aria-hidden="true"
    >
        <div class="p-3 pt-0 space-y-3">
            <div class="flex items-center gap-3">
                <button
                    id="play-button"
                    class="play-btn-physical p-3 rounded-xl bg-studio-chassis-800 text-studio-amber hover:bg-studio-chassis-700 transition-all duration-150 flex items-center justify-center shadow-bezel-out border border-studio-chassis-600"
                    aria-label="Reproducir audio"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>

                <div class="flex-1 flex flex-col gap-1">
                    <!-- Pantalla LCD: waveform -->
                    <div
                        id="waveform-container"
                        class="w-full max-w-xs h-10 bg-studio-chassis-950 rounded-lg border border-studio-chassis-700 shadow-bezel-in"
                    >
                    </div>
                    <div class="text-studio-cream/70 text-[10px] font-mono text-center">
                        <span id="current-time">0:00</span> / <span id="total-time">0:00</span>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-1.5 border-t border-studio-chassis-800 pt-2">
                <label class="silk-label text-[9px] text-studio-cream/60">STEM TRACKS MONITOR:</label>
                <div class="flex flex-wrap gap-1.5">
                    <button
                        id="btn-bass"
                        class="track-btn active px-2 py-1 text-[10px] font-mono rounded border border-studio-red/50 bg-studio-red/20 text-studio-cream hover:bg-studio-red/30 shadow-sm"
                        data-track="bass"
                        ><span class="track-led bg-studio-red"></span>Bass</button
                    >
                    <button
                        id="btn-drums"
                        class="track-btn active px-2 py-1 text-[10px] font-mono rounded border border-studio-amber/50 bg-studio-amber/20 text-studio-cream hover:bg-studio-amber/30 shadow-sm"
                        data-track="drums"
                        ><span class="track-led bg-studio-amber"></span>Drums</button
                    >
                    <button
                        id="btn-vocals"
                        class="track-btn active px-2 py-1 text-[10px] font-mono rounded border border-studio-slate/50 bg-studio-slate/20 text-studio-cream hover:bg-studio-slate/30 shadow-sm"
                        data-track="vocals"
                        ><span class="track-led bg-studio-slate"></span>Vocals</button
                    >
                    <button
                        id="btn-other"
                        class="track-btn active px-2 py-1 text-[10px] font-mono rounded border border-studio-green/50 bg-studio-green/20 text-studio-cream hover:bg-studio-green/30 shadow-sm"
                        data-track="other"
                        ><span class="track-led bg-studio-green"></span>Other</button
                    >
                </div>
            </div>

            <div class="flex items-center gap-2 border-t border-studio-chassis-800 pt-2">
                <label for="volume-slider" class="silk-label text-[9px] text-studio-cream/60 whitespace-nowrap"
                    >MASTER GAIN:</label
                >
                <input
                    type="range"
                    id="volume-slider"
                    min="0"
                    max="100"
                    value="70"
                    aria-label="Ajustar volumen del audio"
                    class="fader-physical flex-1 max-w-[120px] h-1.5 rounded-lg appearance-none cursor-pointer"
                />
            </div>
        </div>
    </div>
</div>

<!-- Lienzo de partículas "de escape": a pantalla completa, solo se usa en
     picos altos de bass/drums (los golpes físicos de la consola). El resto
     de las pistas se queda con sus partículas contenidas dentro del panel. -->
<canvas
    id="fx-particles-overlay"
    class="fixed inset-0 z-40 pointer-events-none"
    style="mix-blend-mode: screen;"
    aria-hidden="true"
></canvas>

<!-- Audio principal (audible) -->
<audio
    id="audio-main"
    src="/music/demo.mp3"
    preload="metadata"
    crossorigin="anonymous"></audio>

<!-- Audio elements para análisis visual (silenciosos) -->
<audio id="audio-bass" preload="metadata" crossorigin="anonymous"></audio>
<audio id="audio-drums" preload="metadata" crossorigin="anonymous"></audio>
<audio id="audio-vocals" preload="metadata" crossorigin="anonymous"></audio>
<audio id="audio-other" preload="metadata" crossorigin="anonymous"></audio>

<script>
    // @ts-ignore
    import WaveSurfer from "wavesurfer.js";

    interface Track {
        name: string;
        audio: HTMLAudioElement;
        context: AudioContext;
        analyser: AnalyserNode;
        source: MediaElementAudioSourceNode | null;
        dataArray: Uint8Array;
        active: boolean;
        color: string;
        panelSelector: string;
        prevIntensity: number; // valor del frame anterior, para detectar "punch"/golpes
    }

    interface Particle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        life: number; // 1 → 0
        decay: number; // cuánto baja `life` por frame
        size: number;
        color: string; // "r, g, b" sin rgba()
        maxOpacity?: number; // tope de opacidad (por defecto 0.85-0.9 según el caso)
    }

    interface PanelElement {
        element: HTMLElement;
        track: string;
        originalBorderColor: string;
        originalBackgroundColor: string;
        originalBoxShadow: string;
        canvas: HTMLCanvasElement | null;
        ctx: CanvasRenderingContext2D | null;
        particles: Particle[];
    }

    class MultiTrackAudioVisualizer {
        private tracks: Map<string, Track> = new Map();
        private panels: PanelElement[] = [];

        // 🔧 Sistema de debug condicional - solo visible en desarrollo
        public debug = {
            log: (message: string, ...args: any[]) => {
                if (import.meta.env.DEV) {
                    console.log(message, ...args);
                }
            },
            warn: (message: string, ...args: any[]) => {
                if (import.meta.env.DEV) {
                    console.warn(message, ...args);
                }
            },
            error: (message: string, ...args: any[]) => {
                // Los errores SIEMPRE se muestran (importante para debugging en producción)
                console.error(message, ...args);
            },
        };
        private playButton: HTMLButtonElement;
        private volumeSlider: HTMLInputElement;
        private currentTimeElement: HTMLElement;
        private totalTimeElement: HTMLElement;
        private waveSurfer: WaveSurfer | null = null;
        private isPlaying: boolean = false;
        private masterTime: number = 0;
        private rafId: number | null = null;
        private mainAudio: HTMLAudioElement | null = null; // Audio principal audible
        private masterAudio: HTMLAudioElement | null = null; // Audio para sincronización

        // Partículas "de escape": viven a pantalla completa, no dentro de un panel
        private overlayCanvas: HTMLCanvasElement | null = null;
        private overlayCtx: CanvasRenderingContext2D | null = null;
        private overlayParticles: Particle[] = [];
        // Solo estas pistas pueden disparar una ráfaga de escape (elegidas a propósito,
        // no todas: son los golpes físicos de la consola, no los sonidos sostenidos).
        // drums (bombo/PROJECTS) se sacó: saturaba la pantalla al salir del panel.
        // Se queda solo con sus partículas contenidas dentro de la tarjeta.
        private readonly ESCAPE_TRACKS = new Set(["bass"]);
        private readonly ESCAPE_PUNCH_THRESHOLD: Record<string, number> = {
            bass: 0.55,
        };
        private readonly ESCAPE_COOLDOWN_MS = 220; // evita ráfagas pegadas una a otra
        private lastEscapeBurst: Record<string, number> = {};

        constructor() {
            this.playButton = document.getElementById(
                "play-button",
            ) as HTMLButtonElement;
            this.volumeSlider = document.getElementById(
                "volume-slider",
            ) as HTMLInputElement;
            this.currentTimeElement = document.getElementById(
                "current-time",
            ) as HTMLElement;
            this.totalTimeElement = document.getElementById(
                "total-time",
            ) as HTMLElement;

            // Inicialización básica inmediata
            this.setupEventListeners();
            this.findPanels();
            this.setupOverlayCanvas();

            // Lazy initialization de recursos pesados
            this.lazyInitializeAudio();
        }

        /**
         * Prepara el canvas de partículas de escape (a pantalla completa,
         * fuera de cualquier panel).
         */
        private setupOverlayCanvas() {
            this.overlayCanvas = document.getElementById(
                "fx-particles-overlay",
            ) as HTMLCanvasElement | null;
            if (!this.overlayCanvas) return;

            this.resizeOverlayCanvas();
            this.overlayCtx = this.overlayCanvas.getContext("2d");
        }

        private resizeOverlayCanvas() {
            if (!this.overlayCanvas) return;
            const dpr = window.devicePixelRatio || 1;
            const width = window.innerWidth;
            const height = window.innerHeight;

            this.overlayCanvas.width = Math.max(1, Math.round(width * dpr));
            this.overlayCanvas.height = Math.max(1, Math.round(height * dpr));

            const ctx = this.overlayCanvas.getContext("2d");
            if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        /**
         * Lazy initialization de recursos de audio para mejorar performance inicial
         * Los recursos pesados se cargan después del render inicial
         */
        private lazyInitializeAudio() {
            // Usar setTimeout para no bloquear el render inicial
            setTimeout(() => {
                this.debug.log("🚀 Iniciando lazy loading de audio...");

                // Cargar audio principal
                this.initializeMainAudio();

                // Cargar pistas después de un delay adicional
                setTimeout(() => {
                    this.initializeTracks();
                }, 100);

                // Cargar WaveSurfer al final
                setTimeout(() => {
                    this.initializeWaveSurfer();
                }, 200);
            }, 50); // Delay mínimo para no bloquear el render
        }

        private initializeMainAudio() {
            // Configurar el audio principal (demo.mp3) que será audible
            this.mainAudio = document.getElementById(
                "audio-main",
            ) as HTMLAudioElement;
            this.mainAudio.volume = 0.7;

            // Este será nuestro audio master para tiempo
            this.masterAudio = this.mainAudio;
        }

        private initializeTracks() {
            const trackConfigs = [
                {
                    name: "bass",
                    file: "/music/bass.mp3",
                    color: "#8B5CF6", // purple
                    panelSelector:
                        '[data-track="bass"], #contact-panel, .contact-panel',
                },
                {
                    name: "drums",
                    file: "/music/drums.mp3",
                    color: "#EF4444", // red
                    panelSelector:
                        '[data-track="drums"], #projects-panel, .projects-panel',
                },
                {
                    name: "vocals",
                    file: "/music/vocals.mp3",
                    color: "#3B82F6", // blue
                    panelSelector:
                        '[data-track="vocals"], #profile-panel, .profile-panel',
                },
                {
                    name: "other",
                    file: "/music/other.mp3",
                    color: "#10B981", // green
                    panelSelector:
                        '[data-track="other"], #code-editor-panel, .code-editor-panel',
                },
            ];

            trackConfigs.forEach(async (config) => {
                const audio = document.getElementById(
                    `audio-${config.name}`,
                ) as HTMLAudioElement;

                if (!audio) {
                    console.error(
                        `❌ Audio element no encontrado: audio-${config.name}`,
                    );
                    return;
                }

                this.debug.log(`🎵 Configurando track: ${config.name}`);

                // Configurar el audio
                audio.src = config.file;
                audio.volume = 0.01; // Volumen muy bajo para análisis (casi inaudible)
                audio.crossOrigin = "anonymous";
                audio.preload = "metadata";

                const context = new (window.AudioContext ||
                    (window as any).webkitAudioContext)();
                const analyser = context.createAnalyser();
                analyser.fftSize = 1024;
                // Menos suavizado = reacciona más rápido a los golpes reales
                // en vez de promediarlos hasta que casi no se noten
                analyser.smoothingTimeConstant = 0.62;

                const track: Track = {
                    name: config.name,
                    audio,
                    context,
                    analyser,
                    source: null,
                    dataArray: new Uint8Array(analyser.frequencyBinCount),
                    active: true,
                    color: config.color,
                    panelSelector: config.panelSelector,
                    prevIntensity: 0,
                };

                this.tracks.set(config.name, track);

                // Manejar eventos de carga
                audio.addEventListener("loadedmetadata", () => {
                    this.debug.log(`✅ Metadata cargada para ${config.name}`);
                    if (!track.source && track.context.state !== "closed") {
                        try {
                            track.source =
                                track.context.createMediaElementSource(audio);
                            track.source.connect(track.analyser);
                            // NO conectar al destination para que sea silencioso
                            // track.source.connect(track.context.destination);
                            this.debug.log(
                                `🔊 Contexto de audio conectado para ${config.name}`,
                            );
                        } catch (error) {
                            console.error(
                                `❌ Error conectando audio context para ${config.name}:`,
                                error,
                            );
                        }
                    }
                });

                audio.addEventListener("error", (e) => {
                    console.error(`❌ Error cargando audio ${config.name}:`, e);
                });

                audio.addEventListener("canplaythrough", () => {
                    console.log(
                        `🎉 Audio listo para reproducir: ${config.name}`,
                    );
                });
            });
        }

        private initializeWaveSurfer() {
            const container = document.getElementById("waveform-container");
            if (!container) return;

            this.waveSurfer = WaveSurfer.create({
                container: container,
                waveColor: "#06B6D4",
                progressColor: "#0891B2",
                height: 48,
                barWidth: 2,
                barGap: 1,
                normalize: true,
            });

            // Cargar el audio principal (demo.mp3) para la visualización de waveform
            this.waveSurfer.load("/music/demo.mp3");

            this.waveSurfer.on("ready", () => {
                if (this.masterAudio) {
                    const duration = this.masterAudio.duration;
                    this.totalTimeElement.textContent =
                        this.formatTime(duration);
                }
            });
        }

        private setupEventListeners() {
            // Funcionalidad del acordeón
            this.setupAccordion();

            this.playButton.addEventListener("click", () => this.togglePlay());

            this.volumeSlider.addEventListener("input", (e) =>
                this.setMainVolume(
                    parseInt((e.target as HTMLInputElement).value),
                ),
            );

            // Botones de activación/desactivación de tracks (solo para visualización)
            document.querySelectorAll(".track-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const trackName = (e.target as HTMLElement).dataset.track;
                    if (trackName) {
                        this.toggleTrackVisualization(trackName);
                    }
                });
            });

            // Sincronizar con el audio principal
            if (this.mainAudio) {
                this.mainAudio.addEventListener("timeupdate", () => {
                    this.masterTime = this.mainAudio!.currentTime;
                    this.currentTimeElement.textContent = this.formatTime(
                        this.masterTime,
                    );

                    // Sincronizar todas las pistas de análisis con el tiempo principal
                    this.tracks.forEach((track) => {
                        if (
                            Math.abs(
                                track.audio.currentTime - this.masterTime,
                            ) > 0.1
                        ) {
                            track.audio.currentTime = this.masterTime;
                        }
                    });

                    if (this.waveSurfer) {
                        this.waveSurfer.setTime(this.masterTime);
                    }
                });

                this.mainAudio.addEventListener("ended", () => {
                    this.stop();
                });
            }
        }

        /**
         * Configura la funcionalidad del acordeón para colapsar/expandir el reproductor
         */
        private setupAccordion() {
            const accordionToggle = document.getElementById("accordion-toggle");
            const accordionContent =
                document.getElementById("accordion-content");
            const chevronIcon = document.getElementById("chevron-icon");
            const audioStatus = document.getElementById("audio-status");

            if (!accordionToggle || !accordionContent || !chevronIcon) {
                this.debug.warn("⚠️ Elementos del acordeón no encontrados");
                return;
            }

            let isExpanded = false;

            accordionToggle.addEventListener("click", () => {
                isExpanded = !isExpanded;

                // Actualizar aria-expanded
                accordionToggle.setAttribute(
                    "aria-expanded",
                    isExpanded.toString(),
                );
                accordionContent.setAttribute(
                    "aria-hidden",
                    (!isExpanded).toString(),
                );

                if (isExpanded) {
                    // Expandir
                    accordionContent.style.maxHeight =
                        accordionContent.scrollHeight + "px";
                    chevronIcon.style.transform = "rotate(180deg)";
                    this.debug.log("🔊 Reproductor expandido");
                } else {
                    // Colapsar
                    accordionContent.style.maxHeight = "0";
                    chevronIcon.style.transform = "rotate(0deg)";
                    this.debug.log("📌 Reproductor colapsado");
                }
            });

            // Actualizar estado del audio en el header
            this.updateAudioStatus = (status: string) => {
                if (audioStatus) {
                    audioStatus.textContent = status;
                }
            };
        }

        private updateAudioStatus?: (status: string) => void;

        private findPanels() {
            this.debug.log("🎵 Buscando paneles para efectos visuales...");

            // Buscar paneles por data-track attribute primero
            const trackConfigs = [
                {
                    name: "bass",
                    file:
                        "/music/" +
                        encodeURIComponent(
                            "El Cuarteto de Nos - Enamorado tuyo (LetraLyrics)-bass-C# minor-96bpm-441hz.mp3",
                        ),
                    color: "#8B5CF6",
                    panelSelector: '[data-track="bass"]',
                },
                {
                    name: "drums",
                    file:
                        "/music/" +
                        encodeURIComponent(
                            "El Cuarteto de Nos - Enamorado tuyo (LetraLyrics)-drums-C# minor-96bpm-441hz.mp3",
                        ),
                    color: "#EF4444",
                    panelSelector: '[data-track="drums"]',
                },
                {
                    name: "vocals",
                    file:
                        "/music/" +
                        encodeURIComponent(
                            "El Cuarteto de Nos - Enamorado tuyo (LetraLyrics)-vocals-C# minor-96bpm-441hz.mp3",
                        ),
                    color: "#3B82F6",
                    panelSelector: '[data-track="vocals"]',
                },
                {
                    name: "other",
                    file:
                        "/music/" +
                        encodeURIComponent(
                            "El Cuarteto de Nos - Enamorado tuyo (LetraLyrics)-other-C# minor-96bpm-441hz.mp3",
                        ),
                    color: "#22C55E",
                    panelSelector: '[data-track="other"]',
                },
            ];

            trackConfigs.forEach((config) => {
                const elements = document.querySelectorAll(
                    config.panelSelector,
                );
                elements.forEach((element) => {
                    if (element instanceof HTMLElement) {
                        const style = window.getComputedStyle(element);
                        const { canvas, ctx } = this.setupParticleCanvas(element);
                        this.panels.push({
                            element: element,
                            track: config.name,
                            originalBorderColor: style.borderColor,
                            originalBackgroundColor: style.backgroundColor,
                            originalBoxShadow: style.boxShadow,
                            canvas,
                            ctx,
                            particles: [],
                        });
                        console.log(
                            `✅ Panel ${config.name} encontrado:`,
                            element,
                        );
                    }
                });
            });

            // Fallback si no encontramos paneles con data-track
            if (this.panels.length === 0) {
                console.log(
                    "⚠️ No se encontraron paneles con data-track, usando fallback...",
                );
                const fallbackPanels = [
                    {
                        selector:
                            '.panel:has([class*="PROFILE"]), .panel:has(h3:contains("PROFILE"))',
                        track: "vocals",
                    },
                    {
                        selector:
                            '.panel:has([class*="CONTACT"]), .panel:has(h3:contains("CONTACT"))',
                        track: "bass",
                    },
                    {
                        selector:
                            '.panel:has([class*="PROJECTS"]), .panel:has(h3:contains("PROJECTS"))',
                        track: "drums",
                    },
                    {
                        selector:
                            '.panel:has([class*="CODE"]), .panel:has(h3:contains("CODE"))',
                        track: "other",
                    },
                ];

                // Si el fallback no funciona, buscar todos los .panel y asignar manualmente
                const allPanels = document.querySelectorAll(".panel");
                console.log(
                    `🔍 Encontrados ${allPanels.length} paneles en total`,
                );

                allPanels.forEach((element, index) => {
                    if (element instanceof HTMLElement) {
                        const trackNames = ["vocals", "drums", "other", "bass"];
                        const track = trackNames[index % trackNames.length];
                        const style = window.getComputedStyle(element);
                        const { canvas, ctx } = this.setupParticleCanvas(element);
                        this.panels.push({
                            element: element,
                            track: track,
                            originalBorderColor: style.borderColor,
                            originalBackgroundColor: style.backgroundColor,
                            originalBoxShadow: style.boxShadow,
                            canvas,
                            ctx,
                            particles: [],
                        });
                        console.log(
                            `🎯 Panel ${index} asignado a ${track}:`,
                            element,
                        );
                    }
                });
            }

            console.log(
                `🎉 Total de paneles configurados: ${this.panels.length}`,
            );

            // Redimensionar los canvases de partículas si la ventana cambia
            // (evita que queden desalineados o borrosos tras un resize)
            window.addEventListener("resize", () => {
                this.panels.forEach((panel) => {
                    if (panel.canvas) this.resizeParticleCanvas(panel.canvas);
                });
                this.resizeOverlayCanvas();
            });
        }

        /**
         * Crea (o localiza) el <canvas class="fx-particles"> dentro de un panel
         * y lo deja dimensionado y listo para dibujar partículas sobre él.
         */
        private setupParticleCanvas(panelElement: HTMLElement): {
            canvas: HTMLCanvasElement | null;
            ctx: CanvasRenderingContext2D | null;
        } {
            const canvas = panelElement.querySelector(
                ".fx-particles",
            ) as HTMLCanvasElement | null;

            if (!canvas) {
                return { canvas: null, ctx: null };
            }

            this.resizeParticleCanvas(canvas);
            const ctx = canvas.getContext("2d");
            return { canvas, ctx };
        }

        /**
         * Ajusta el tamaño real (en píxeles de dispositivo) del canvas al
         * tamaño visual de su panel contenedor, para que las partículas se
         * vean nítidas también en pantallas de alta densidad (retina).
         */
        private resizeParticleCanvas(canvas: HTMLCanvasElement) {
            const parent = canvas.parentElement;
            const width = parent?.clientWidth || canvas.clientWidth || 100;
            const height = parent?.clientHeight || canvas.clientHeight || 100;
            const dpr = window.devicePixelRatio || 1;

            canvas.width = Math.max(1, Math.round(width * dpr));
            canvas.height = Math.max(1, Math.round(height * dpr));

            const ctx = canvas.getContext("2d");
            if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        // Color base (formato "r, g, b") de la partícula de cada instrumento,
        // alineado con los LEDs/acentos que ya usa cada panel
        private readonly PARTICLE_COLORS: Record<string, string> = {
            bass: "220, 38, 38", // studio-red   (CONTACT / MASTER OUTPUT)
            drums: "245, 158, 11", // studio-amber (PROJECTS)
            vocals: "56, 189, 248", // studio-slate (PROFILE)
            other: "22, 163, 74", // studio-green (MUSIC / CODE EDITOR)
        };

        /**
         * Genera partículas nuevas para un panel según qué instrumento es
         * (bass/drums/vocals/other), respetando el "carácter" de cada uno:
         *
         *  - bass:   brasas que suben lento desde abajo — el calor grave de un ampli.
         *  - drums:  estallido radial desde el centro en cada golpe (punch) — un platillo.
         *  - vocals: motas que flotan hacia arriba con vaivén — el aliento de una voz.
         *  - other:  una corriente que fluye en diagonal — una melodía continua.
         */
        private spawnParticles(
            panel: PanelElement,
            trackName: string,
            intensity: number,
            punch: number,
        ) {
            if (!panel.ctx || !panel.canvas) return;
            if (intensity < 0.1) return; // puerta de ruido: silencio no genera partículas
            if (panel.particles.length > 70) return; // límite por panel, cuida el rendimiento

            const dpr = window.devicePixelRatio || 1;
            const w = panel.canvas.width / dpr;
            const h = panel.canvas.height / dpr;
            const color = this.PARTICLE_COLORS[trackName] || "255, 255, 255";

            // Más intensidad y más "golpe" → más partículas por frame analizado
            const spawnCount = Math.min(
                5,
                Math.round(intensity * 2.5) + (punch > 0.3 ? 2 : 0),
            );

            for (let i = 0; i < spawnCount; i++) {
                let particle: Particle;

                switch (trackName) {
                    case "bass":
                        particle = {
                            x: Math.random() * w,
                            y: h + 4,
                            vx: (Math.random() - 0.5) * 0.3,
                            vy: -(0.35 + Math.random() * 0.5) * (0.6 + intensity),
                            life: 1,
                            decay: 0.01 + Math.random() * 0.008,
                            size: 1.5 + Math.random() * 2 + intensity * 2.5,
                            color,
                        };
                        break;

                    case "drums": {
                        const angle = Math.random() * Math.PI * 2;
                        const speed = 1.2 + Math.random() * 1.8 + punch * 3.5;
                        particle = {
                            x: w / 2,
                            y: h / 2,
                            vx: Math.cos(angle) * speed,
                            vy: Math.sin(angle) * speed,
                            life: 1,
                            decay: 0.035 + Math.random() * 0.02,
                            size: 1.5 + Math.random() * 1.5 + punch * 1.5,
                            color,
                        };
                        break;
                    }

                    case "vocals":
                        particle = {
                            x: Math.random() * w,
                            y: h + 4,
                            vx: Math.sin(Date.now() / 350 + i) * 0.35,
                            vy: -(0.22 + Math.random() * 0.3),
                            life: 1,
                            decay: 0.007 + Math.random() * 0.006,
                            size: 1 + Math.random() * 1.4,
                            color,
                        };
                        break;

                    case "other":
                    default:
                        particle = {
                            x: -4,
                            y: Math.random() * h,
                            vx: 0.55 + Math.random() * 0.55 + intensity * 0.6,
                            vy: (Math.random() - 0.5) * 0.35,
                            life: 1,
                            decay: 0.009 + Math.random() * 0.007,
                            size: 1.5 + Math.random() * 1.5,
                            color,
                        };
                        break;
                }

                panel.particles.push(particle);
            }
        }

        /**
         * Actualiza posición/vida y dibuja las partículas de todos los
         * paneles. Se llama en cada frame (sin el throttle del análisis de
         * audio) para que el movimiento se vea fluido.
         */
        private updateAndRenderParticles() {
            const dpr = window.devicePixelRatio || 1;

            this.panels.forEach((panel) => {
                if (!panel.ctx || !panel.canvas) return;

                const w = panel.canvas.width / dpr;
                const h = panel.canvas.height / dpr;
                panel.ctx.clearRect(0, 0, w, h);

                if (panel.particles.length === 0) return;

                panel.particles = panel.particles.filter(
                    (p) => p.life > 0,
                );

                for (const p of panel.particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.life -= p.decay;
                    if (p.life <= 0) continue;

                    const radius = Math.max(0.3, p.size * p.life);
                    panel.ctx.beginPath();
                    panel.ctx.fillStyle = `rgba(${p.color}, ${Math.min(1, p.life) * 0.85})`;
                    panel.ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
                    panel.ctx.fill();
                }
            });
        }

        /**
         * Lanza una ráfaga de partículas que nace en un panel pero vive en el
         * canvas de pantalla completa: se ve salir del módulo y cruzar la
         * ventana. Solo se llama para picos altos de las pistas en ESCAPE_TRACKS.
         */
        private spawnEscapeBurst(
            originElement: HTMLElement,
            trackName: string,
            punch: number,
        ) {
            if (!this.overlayCtx || !this.overlayCanvas) return;
            if (this.overlayParticles.length > 140) return; // límite global

            const rect = originElement.getBoundingClientRect();
            const originX = rect.left + rect.width / 2;
            const originY = rect.top + rect.height / 2;
            const color = this.PARTICLE_COLORS[trackName] || "255, 255, 255";

            // El bombo (drums) es el más difícil de notar al pulsar, así que
            // su ráfaga es más grande, rápida y brillante que la de bass.
            const isDrums = trackName === "drums";
            const baseCount = isDrums ? 22 : 14;
            const punchCount = isDrums ? 22 : 14;
            const baseSpeed = isDrums ? 4.5 : 3;
            const speedRange = isDrums ? 6.5 : 5;
            const punchSpeed = isDrums ? 5.5 : 4;
            const baseSize = isDrums ? 2.8 : 2;
            const sizeRange = isDrums ? 3.4 : 2.5;
            const maxOpacity = isDrums ? 1 : 0.9;

            // Ráfaga más grande cuanto más fuerte fue el golpe
            const count = baseCount + Math.round(punch * punchCount);

            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                // Rápidas a propósito: tienen que cruzar la ventana, no quedarse cerca
                const speed =
                    baseSpeed + Math.random() * speedRange + punch * punchSpeed;

                this.overlayParticles.push({
                    x: originX,
                    y: originY,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 1, // leve empuje hacia arriba
                    life: 1,
                    decay: 0.006 + Math.random() * 0.006, // vive más para alcanzar a cruzar
                    size: baseSize + Math.random() * sizeRange,
                    color,
                    maxOpacity,
                });
            }
        }

        /**
         * Actualiza y dibuja las partículas de escape sobre el canvas de
         * pantalla completa. Se llama en cada frame, igual que las de panel.
         */
        private updateAndRenderOverlayParticles() {
            if (!this.overlayCtx || !this.overlayCanvas) return;

            const dpr = window.devicePixelRatio || 1;
            const w = this.overlayCanvas.width / dpr;
            const h = this.overlayCanvas.height / dpr;
            this.overlayCtx.clearRect(0, 0, w, h);

            if (this.overlayParticles.length === 0) return;

            this.overlayParticles = this.overlayParticles.filter(
                (p) => p.life > 0,
            );

            for (const p of this.overlayParticles) {
                p.vy += 0.01; // gravedad muy leve, para que el trayecto no sea perfectamente recto
                p.x += p.vx;
                p.y += p.vy;
                p.life -= p.decay;
                if (p.life <= 0) continue;

                const radius = Math.max(0.4, p.size * p.life);
                const opacity = Math.min(1, p.life) * (p.maxOpacity ?? 0.9);
                this.overlayCtx.beginPath();
                this.overlayCtx.fillStyle = `rgba(${p.color}, ${opacity})`;
                this.overlayCtx.arc(p.x, p.y, radius, 0, Math.PI * 2);
                this.overlayCtx.fill();
            }
        }

        private togglePlay() {
            if (this.isPlaying) {
                this.pause();
            } else {
                this.play();
            }
        }

        /**
         * Espera a que un <audio> esté realmente listo para reproducirse sin cortes.
         * Con preload="metadata" el primer play casi nunca alcanza HAVE_FUTURE_DATA a
         * tiempo, así que sin esto las pistas de análisis se saltan silenciosamente y
         * los paneles no reaccionan en la primera reproducción. Timeout defensivo para
         * no bloquear indefinidamente si una pista nunca dispara el evento.
         */
        private waitForCanPlay(
            audio: HTMLAudioElement,
            timeoutMs = 3000,
        ): Promise<void> {
            return new Promise((resolve) => {
                if (audio.readyState >= 3) {
                    // HAVE_FUTURE_DATA
                    resolve();
                    return;
                }

                let settled = false;
                const cleanup = () => {
                    audio.removeEventListener("canplaythrough", onReady);
                    clearTimeout(timer);
                };
                const onReady = () => {
                    if (settled) return;
                    settled = true;
                    cleanup();
                    resolve();
                };
                const timer = setTimeout(() => {
                    if (settled) return;
                    settled = true;
                    this.debug.warn(
                        `⏱️ Timeout esperando canplaythrough para ${audio.currentSrc || "pista"}`,
                    );
                    cleanup();
                    resolve();
                }, timeoutMs);

                audio.addEventListener("canplaythrough", onReady, {
                    once: true,
                });

                if (audio.readyState === 0) {
                    audio.load();
                }
            });
        }

        private async play() {
            try {
                this.debug.log("🎵 Iniciando reproducción...");

                // Reanudar todos los contextos de audio
                for (const track of this.tracks.values()) {
                    if (track.context.state === "suspended") {
                        await track.context.resume();
                        this.debug.log(
                            `🔊 Contexto reanudado para ${track.name}`,
                        );
                    }
                }

                // Reproducir el audio principal (audible)
                if (this.mainAudio) {
                    this.mainAudio.currentTime = this.masterTime;
                    await this.mainAudio.play();
                    this.debug.log("🎵 Audio principal reproduciendo");
                }

                // Esperar a que las pistas activas estén realmente listas antes de
                // reproducirlas (evita que la primera reproducción quede sin efectos
                // visuales por no haber alcanzado readyState suficiente aún)
                const activeTracks = Array.from(this.tracks.values()).filter(
                    (track) => track.active,
                );
                await Promise.all(
                    activeTracks.map((track) =>
                        this.waitForCanPlay(track.audio),
                    ),
                );

                // Reproducir todas las pistas de análisis (silenciosas) de forma sincronizada
                const playPromises: Promise<void>[] = [];
                this.debug.log(
                    `🎵 Intentando reproducir ${this.tracks.size} pistas de análisis...`,
                );

                this.tracks.forEach((track) => {
                    this.debug.log(
                        `🔍 Pista ${track.name}: active=${track.active}, readyState=${track.audio.readyState}, currentSrc=${track.audio.currentSrc}`,
                    );

                    if (track.active) {
                        this.debug.log(
                            `▶️ Reproduciendo pista ${track.name}...`,
                        );
                        track.audio.currentTime = this.masterTime;
                        playPromises.push(
                            track.audio
                                .play()
                                .then(() => {
                                    this.debug.log(
                                        `✅ Pista ${track.name} reproduciéndose`,
                                    );
                                })
                                .catch((e) => {
                                    this.debug.warn(
                                        `⚠️ No se pudo reproducir ${track.name}:`,
                                        e,
                                    );
                                }),
                        );
                    } else {
                        this.debug.warn(
                            `❌ Pista ${track.name} inactiva: active=${track.active}`,
                        );
                    }
                });

                await Promise.all(playPromises);

                this.isPlaying = true;
                this.updatePlayButton();
                this.startVisualization();
                this.debug.log("🎉 Reproducción iniciada exitosamente");

                // Actualizar estado en el header del acordeón
                this.updateAudioStatus?.("Reproduciendo...");
            } catch (error) {
                console.error("❌ Error al reproducir:", error);
                this.isPlaying = false;
                this.updatePlayButton();
                this.updateAudioStatus?.("Error al reproducir");
            }
        }

        private pause() {
            this.debug.log("⏸️ Pausando reproducción...");

            // Pausar audio principal
            if (this.mainAudio) {
                this.mainAudio.pause();
            }

            // Pausar pistas de análisis
            this.tracks.forEach((track) => {
                track.audio.pause();
            });

            this.isPlaying = false;
            this.updatePlayButton();
            this.stopVisualization();

            // Actualizar estado en el header del acordeón
            this.updateAudioStatus?.("Pausado");
        }

        private updatePlayButton() {
            if (this.isPlaying) {
                // Botón principal - icono de pausa
                this.playButton.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        `;
                this.playButton.classList.add("playing");
            } else {
                // Botón principal - icono de play
                this.playButton.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
        `;
                this.playButton.classList.remove("playing");
            }
        }

        private stop() {
            this.pause();
            this.masterTime = 0;

            // Reiniciar audio principal
            if (this.mainAudio) {
                this.mainAudio.currentTime = 0;
            }

            // Reiniciar pistas de análisis
            this.tracks.forEach((track) => {
                track.audio.currentTime = 0;
            });

            if (this.waveSurfer) {
                this.waveSurfer.setTime(0);
            }
        }

        private setMainVolume(volume: number) {
            const normalizedVolume = volume / 100;
            // Solo cambiar el volumen del audio principal
            if (this.mainAudio) {
                this.mainAudio.volume = normalizedVolume;
            }
            // Las pistas de análisis siempre permanecen en silencio
        }

        private toggleTrackVisualization(trackName: string) {
            const track = this.tracks.get(trackName);
            if (!track) return;

            track.active = !track.active;
            const btn = document.getElementById(
                `btn-${trackName}`,
            ) as HTMLButtonElement;

            if (track.active) {
                btn.style.opacity = "1";
                btn.classList.add("active");
                if (this.isPlaying) {
                    track.audio.currentTime = this.masterTime;
                    track.audio.play();
                }
            } else {
                btn.style.opacity = "0.5";
                btn.classList.remove("active");
                track.audio.pause();
            }
        }

        // Usar requestIdleCallback cuando esté disponible para optimizar rendimiento
        private startVisualization() {
            if (this.rafId) return;

            // Priorizar el renderizado de la UI sobre el análisis de audio
            const visualize = () => {
                if (!this.isPlaying) return;

                // Usar requestIdleCallback si está disponible para no bloquear el hilo principal
                if ("requestIdleCallback" in window) {
                    // @ts-ignore - TypeScript no reconoce requestIdleCallback
                    window.requestIdleCallback(
                        () => {
                            this.analyzeAudio();
                        },
                        { timeout: 1000 / 30 },
                    ); // Garantizar que se ejecute al menos 30 veces por segundo
                } else {
                    this.analyzeAudio();
                }

                // Las partículas se mueven y se dibujan en TODOS los frames
                // (no solo cuando toca analizar audio) para que el movimiento
                // se vea fluido en vez de a saltos.
                this.updateAndRenderParticles();
                this.updateAndRenderOverlayParticles();

                this.rafId = requestAnimationFrame(visualize);
            };

            visualize();
        }

        // Contador para limitar la frecuencia de análisis
        private analyzeCounter = 0;
        private readonly ANALYZE_THROTTLE = 2; // Analizar 1 de cada 2 frames: más reactivo que antes (era 1 de cada 3)

        private analyzeAudio() {
            // Limitar la frecuencia de análisis para reducir carga de CPU
            this.analyzeCounter++;
            if (this.analyzeCounter % this.ANALYZE_THROTTLE !== 0) return;

            // Evitar logs excesivos en producción
            this.debug.log(`🔍 Analizando ${this.tracks.size} pistas...`);

            // Usar una cola de microtareas para no bloquear el hilo principal
            // y permitir que la UI se actualice primero
            queueMicrotask(() => {
                this.tracks.forEach((track) => {
                    this.debug.log(
                        `🎵 Pista ${track.name}: active=${track.active}, paused=${track.audio.paused}, source=${!!track.source}`,
                    );

                    if (!track.active || !track.source || track.audio.paused) {
                        this.debug.log(
                            `⏸️ Saltando pista ${track.name} - no activa o pausada`,
                        );
                        return;
                    }

                    try {
                        track.analyser.getByteFrequencyData(track.dataArray);

                        // Verificar si hay datos de audio
                        const sum = track.dataArray.reduce((a, b) => a + b, 0);

                        if (sum === 0) {
                            this.debug.warn(
                                `⚠️ Pista ${track.name} no tiene datos de audio - readyState: ${track.audio.readyState}, currentTime: ${track.audio.currentTime}, duration: ${track.audio.duration}`,
                            );

                            // Reset sutil de efectos cuando no hay datos
                            const relevantPanels = this.panels.filter(
                                (panel) => panel.track === track.name,
                            );
                            relevantPanels.forEach((panel) => {
                                panel.element.style.transform = "scale(1)"; // Volver a tamaño normal
                                panel.element.style.borderColor =
                                    panel.originalBorderColor;
                                panel.element.style.background = ""; // Limpiar gradiente
                                panel.element.style.boxShadow =
                                    panel.originalBoxShadow;
                                panel.element.style.borderWidth = ""; // Limpiar borde dinámico
                                panel.element.style.filter = ""; // Limpiar filtros
                            });
                            return;
                        }

                        // Calcular diferentes bandas de frecuencia
                        const dataLength = track.dataArray.length;
                        const bassData = track.dataArray.slice(
                            0,
                            Math.floor(dataLength * 0.1),
                        );
                        const midData = track.dataArray.slice(
                            Math.floor(dataLength * 0.1),
                            Math.floor(dataLength * 0.5),
                        );
                        const trebleData = track.dataArray.slice(
                            Math.floor(dataLength * 0.5),
                        );

                        const bassAvg =
                            bassData.reduce((a, b) => a + b, 0) /
                            bassData.length;
                        const midAvg =
                            midData.reduce((a, b) => a + b, 0) / midData.length;
                        const trebleAvg =
                            trebleData.reduce((a, b) => a + b, 0) /
                            trebleData.length;
                        const totalAvg =
                            track.dataArray.reduce((a, b) => a + b, 0) /
                            track.dataArray.length;

                        // Normalizar valores (0-1) y amplificar para mayor sensibilidad
                        // de detección (subido respecto a la versión anterior: 10x/15x → 16x/22x)
                        const normalizedBass = Math.min(
                            (bassAvg / 255) * 16,
                            1,
                        );
                        const normalizedMid = Math.min((midAvg / 255) * 16, 1);
                        const normalizedTreble = Math.min(
                            (trebleAvg / 255) * 16,
                            1,
                        );
                        const normalizedTotal = Math.min(
                            (totalAvg / 255) * 22,
                            1,
                        );

                        // Detección de "punch" (transiente/golpe): salto brusco respecto
                        // al frame anterior. Sirve para que drums/bass reaccionen como un
                        // golpe real y no solo como volumen sostenido.
                        const punch = Math.min(
                            1,
                            Math.max(0, normalizedTotal - track.prevIntensity) * 3.5,
                        );
                        track.prevIntensity = normalizedTotal;

                        // Aplicar efectos a paneles específicos para esta pista
                        const relevantPanels = this.panels.filter(
                            (panel) => panel.track === track.name,
                        );

                        // Verificar si hay paneles para aplicar efectos
                        if (relevantPanels.length > 0) {
                            this.debug.log(
                                `🎨 Aplicando efectos a ${relevantPanels.length} paneles para ${track.name}`,
                            );

                            // Aplicar efectos a cada panel encontrado
                            relevantPanels.forEach((panel) => {
                                // Aplicar efectos visuales basados en las diferentes bandas de frecuencia
                                this.applyTrackEffect(
                                    panel,
                                    track,
                                    normalizedBass,
                                    normalizedMid,
                                    normalizedTreble,
                                    normalizedTotal,
                                );
                                // Emitir partículas propias de este instrumento
                                this.spawnParticles(
                                    panel,
                                    track.name,
                                    normalizedTotal,
                                    punch,
                                );
                            });

                            // En picos altos de verdad, y solo para las pistas elegidas
                            // (bombo/drums y bass), una ráfaga que escapa del panel y
                            // cruza toda la ventana — el resto de las pistas se queda
                            // contenida dentro de su panel.
                            if (
                                this.ESCAPE_TRACKS.has(track.name) &&
                                punch >=
                                    (this.ESCAPE_PUNCH_THRESHOLD[
                                        track.name
                                    ] ?? 0.55)
                            ) {
                                const now = performance.now();
                                const last =
                                    this.lastEscapeBurst[track.name] || 0;
                                if (now - last >= this.ESCAPE_COOLDOWN_MS) {
                                    this.lastEscapeBurst[track.name] = now;
                                    this.spawnEscapeBurst(
                                        relevantPanels[0].element,
                                        track.name,
                                        punch,
                                    );
                                }
                            }
                        }
                    } catch (error) {
                        this.debug.warn(
                            `⚠️ Error analizando audio para ${track.name}:`,
                            error,
                        );
                    }
                });
            });
        }

        // Método obsoleto - usar analyzeAudio en su lugar
        private updatePanelsForTrack(track: Track) {
            // Este método ya no se usa, pero lo mantenemos para compatibilidad
            // Todo el procesamiento se hace ahora en analyzeAudio
            return;
        }

        /**
         * Aplica efectos visuales a un panel basado en los datos de frecuencia de audio
         * @param panel - El panel HTML al que aplicar efectos
         * @param track - La pista de audio asociada
         * @param normalizedBass - Valor normalizado de frecuencias bajas (0-1)
         * @param normalizedMid - Valor normalizado de frecuencias medias (0-1)
         * @param normalizedTreble - Valor normalizado de frecuencias altas (0-1)
         * @param normalizedTotal - Valor normalizado de todas las frecuencias (0-1)
         */
        private applyTrackEffect(
            panel: PanelElement,
            track: Track,
            normalizedBass: number,
            normalizedMid: number,
            normalizedTreble: number,
            normalizedTotal: number,
        ): void {
            // Usar normalizedTotal como intensidad principal para compatibilidad
            const intensity = normalizedTotal;
            const element = panel.element;

            switch (track.name) {
                case "bass":
                    // Indicador LED rojo recording (CONTACT / MASTER OUT)
                    const bassScale = 1 + intensity * 0.14;
                    const bassOpacity = 0.45 + intensity * 0.65;
                    element.style.transform = `scale(${bassScale})`;
                    element.style.borderColor = `rgba(220, 38, 38, ${bassOpacity})`;
                    element.style.boxShadow = `
                        0 0 ${intensity * 12}px rgba(220, 38, 38, ${intensity * 0.8}),
                        inset 0 0 ${intensity * 10}px rgba(220, 38, 38, ${intensity * 0.25})`;
                    break;

                case "drums":
                    // Indicador LED ámbar cálido de medidor VU (PROJECTS)
                    const drumsScale = 1 + intensity * 0.17;
                    const drumsOpacity = 0.55 + intensity * 0.55;
                    const drumsPulse = Math.sin(Date.now() / 120) * intensity * 0.06;
                    element.style.transform = `scale(${drumsScale + drumsPulse})`;
                    element.style.borderColor = `rgba(245, 158, 11, ${drumsOpacity})`;
                    element.style.boxShadow = `
                        inset 0 0 ${intensity * 14}px rgba(245, 158, 11, ${intensity * 0.45}),
                        0 0 ${intensity * 14}px rgba(245, 158, 11, ${intensity * 0.55})`;
                    break;

                case "vocals":
                    // Indicador azul pizarra técnico de preamp (PROFILE)
                    const vocalsScale = 1 + intensity * 0.11;
                    element.style.transform = `scale(${vocalsScale})`;
                    element.style.borderColor = `rgba(56, 189, 248, ${0.45 + intensity * 0.65})`;
                    element.style.boxShadow = `0 0 ${intensity * 14}px rgba(56, 189, 248, ${intensity * 0.55})`;
                    break;

                case "other":
                    // Indicador verde señal analógica limpia (MUSIC PROJECTS + CODE EDITOR)
                    const otherScale = 1 + intensity * 0.13;
                    element.style.transform = `scale(${otherScale})`;
                    element.style.borderColor = `rgba(22, 163, 74, ${0.45 + intensity * 0.55})`;
                    element.style.boxShadow = `
                        0 0 ${intensity * 13}px rgba(22, 163, 74, ${intensity * 0.55}),
                        inset 0 0 ${intensity * 10}px rgba(22, 163, 74, ${intensity * 0.25})`;
                    break;
            }
        }

        private stopVisualization() {
            if (this.rafId) {
                cancelAnimationFrame(this.rafId);
                this.rafId = null;
            }

            // Restaurar estilos originales completamente
            this.panels.forEach((panel) => {
                panel.element.style.borderColor = panel.originalBorderColor;
                panel.element.style.backgroundColor =
                    panel.originalBackgroundColor;
                panel.element.style.boxShadow = panel.originalBoxShadow;
                panel.element.style.transform = "";
                panel.element.style.background = ""; // Limpiar gradientes
                panel.element.style.filter = ""; // Limpiar filtros
                panel.element.style.borderWidth = ""; // Limpiar borde dinámico

                // Apagar y limpiar las partículas del panel
                panel.particles = [];
                if (panel.ctx && panel.canvas) {
                    const dpr = window.devicePixelRatio || 1;
                    panel.ctx.clearRect(
                        0,
                        0,
                        panel.canvas.width / dpr,
                        panel.canvas.height / dpr,
                    );
                }
            });

            // Apagar y limpiar también las partículas de escape
            this.overlayParticles = [];
            if (this.overlayCtx && this.overlayCanvas) {
                const dpr = window.devicePixelRatio || 1;
                this.overlayCtx.clearRect(
                    0,
                    0,
                    this.overlayCanvas.width / dpr,
                    this.overlayCanvas.height / dpr,
                );
            }
        }

        private formatTime(seconds: number): string {
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs.toString().padStart(2, "0")}`;
        }

        public getPanelCount(): number {
            return this.panels.length;
        }

        public checkReady(): boolean {
            return this.panels.length > 0 && this.tracks.size > 0;
        }
    }

    // Inicializar cuando la página esté lista
    window.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => {
            const visualizer = new MultiTrackAudioVisualizer();
            visualizer.debug.log("🚀 MultiTrack Audio Visualizer initialized");

            // Auto-iniciar visualización después de cargar
            setTimeout(() => {
                const panelCount = visualizer.getPanelCount();
                if (panelCount > 0) {
                    console.log(
                        `✅ ${panelCount} paneles detectados y listos para animación`,
                    );
                } else {
                    visualizer.debug.warn(
                        "⚠️ No se detectaron paneles para animación",
                    );
                }

                // Hacer el visualizador accesible globalmente para debug
                (window as any).audioVisualizer = visualizer;
            }, 2000);
        }, 500);
    });
</script>

